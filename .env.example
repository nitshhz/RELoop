# ReLoop Environment Configuration Example
# Copy this file to server/.env and adjust as necessary

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Neon Free Tier)
DATABASE_URL=postgresql://reloop_user:your_password@ep-example.neon.tech/reloop?sslmode=require

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# File Storage Configuration (local or cloudinary)
STORAGE_TYPE=local
# If using Cloudinary:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Hosted AI Configuration (Google Gemini Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery (Resend - 3,000 free emails/month at https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="ReLoop <onboarding@resend.dev>"

# Initial Admin User (for seeding)
ADMIN_INITIAL_EMAIL=admin@reloop.dev
ADMIN_INITIAL_PASSWORD=AdminSecurePassword123!

